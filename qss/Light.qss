    color: "#000000";
}

/* Shortcut Setting */
QWidget[objectName="sc_setting_tab"] QLabel{
    color: "#000000";
}
QWidget[objectName="sc_setting_tab"] QLineEdit{
    background-color: "#FFFFFF";
    border: 1px solid "#D0D5DD";
    color: "#000000";
    border-radius: 2px;
}
QWidget[objectName="sc_setting_tab"] QLineEdit:focus{
    border-bottom: 1px solid "#3F51B5";
}
QWidget[objectName="sc_setting_tab"] QPushButton {
    background-color: "#F7F7F7";
    border: 1px solid "#D0D5DD";
    color: "#000000";
    padding-left: 2px;
    padding-right: 2px;
    border-radius: 2px;
}
QWidget[objectName="sc_setting_tab"] QPushButton:hover {
    background-color: "#DDE1E6";
}
QWidget[objectName="sc_setting_tab"] QPushButton:pressed {
    background-color: "#C1C7CD";
}

